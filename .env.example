# ── Supabase (required) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ── Email notifications via Resend (Edge Function secrets) ───────────────────
# These are NOT set here in .env — they are set as secrets in the
# Supabase Dashboard under:
#   Edge Functions → notify-payment → Secrets
#
# RESEND_API_KEY   — your Resend API key (get one free at https://resend.com)
#                    Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxx
#
# FROM_EMAIL       — the verified sender address configured in Resend
#                    e.g. reunion@yourdomain.com  or  onboarding@resend.dev (for testing)
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically
# by Supabase into every Edge Function — you do not need to set them.
